<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Include explicitly so a clean checkout can generate it after evaluation. -->
    <Compile Remove="Generated/Protocol.g.cs" />
    <Compile Include="Generated/Protocol.g.cs" />
  </ItemGroup>
  <Target Name="GenerateProtocolBindings" BeforeTargets="BeforeCompile">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../tools/generate-dotnet-bindings.py&quot;" />
  </Target>
</Project>
